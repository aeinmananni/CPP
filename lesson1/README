// ابتدا پوشه ای که میخوایم توش برنامه سی پلاس بنویسم رو کامپایل میکنم
//   رو ایجاد میکنیم compile  اول پوشه 

//   و بعد
// "g++ main.cpp -o compile/main.exe"

// و سپس برنامه رو اجرا میکنیم
// (base) PS D:\projects\CPP> compile/main.exe
// Hello Arduino World

  // میتونیم حتی این دستورات رو توی یک خط نیز اجرا کنیم
  // "g++ ./lesson1/main.cpp -o compile/main.exe; compile/main.exe"

// -------------------------------------------------------------------------
//  بین کارکتر ها فاصله ایجاد کنیم "\t" میتونیم با قرار دادن 
//  ----------------------------------------------------------------------
  //  نیز استفاده کنیم endl استفاده میکنم و به جای استفاده کردن از  این کارکتر میتوانیم از "\n" برای رفتن به خط بعد 
// ----------------------------------------------------------------
  // "\b" : این کارکتر باعث میشود یک اسپیس به عقب برگردد و در واقع حرف اول حروف دوم روی حرف اخر جمله اول قرار بگیرد
  // -------------------------------------------------------------------
  // "\a" : بوق سیستم رو به صدا در میاره
  // -------------------------------------------------------------------
  // "int" : زمانی که متغییری رو با این نوع داده ای تعریف میکنم چهار بایت فضا اشغال میکند و در بعضی از سیستم ها تا دوبایت
  //       زمانی که متغییر ما چهر بایتی است ما باید مقدار خود رو در ان رنج قرار دهیم
  //       منفی دومیلیارد تا مثبت دومیلیارد
  //       میتونیم توی این متغییر ذخیره کنیم
// ------------------------------------------------------------------------------------

  /*
    float : برای داده های اعشاری چهاربایتی است

    double : برای اعشاری های بزرگ استفاده میشود هشت بایتی است

    char : ('') برای گرفتن کارکتر استفاده میشه و متغییر از جنس کارتکر سایزش یک بایتی است باید کارکتر با سینگل کوتیشن تعریف شود 

    unsigned int : دیگر نباید به این متغییر منفی بدهیم

    unsigned char : قرار ندهیم رنج میشود از -128 تا +127 unsigned  رنج کارکتر از 0 میشود تا 255 در صورتی که 

  ----------------------------------------------------------------------------------------------------------------------
     1- عملگر های منتطقی محاسباتی: (- , + , * , / , % , ++ , --)

      % : یعنی دو عدد رو به هم تقسیم کن و باقی مانده رو نمایش بده 

     2- عملگر های رابطه ای یا مقایسه ای : (< , > , <= , >= , ==, !=)

     3- عملگر های منطقی : (! ,  && , ||) 
                        حاصل این عملگر ها True or False

     4- عملگر های ترکیبی : (+= , -= , *= , /= , %=)

     5- عملگر های بیتی : ((& AND), (| OR) , (~ NOT), ( <<  SHIFT LEFT),( >> SHIFT RIGHT ),(^ XOR))

     (<< ,  >> ) : اطلاعات رو نصف یا 2 برابر میکنند شیف چپ اطلاعات رو 2 برابر میکند شیف راست اطلاعات رو نصف میکند

     ^ : خواهد بود True هر دو عبارت باهم برابر نباشند حاصل برابر با 

        1 ^ 0 = TRUE



        برایاینکه بخواهیم 2 عمل را به صورت جدا انجام دهیم میتوانیم به این صورت ان ها را انجام دهیم
        int COUNT_1 = 2, COUNT_2;

         COUNT_2 = (COUNT_1 += 10, COUNT_1 + 5);

          cout << "RESULT_COUNT : " << COUNT_2 << endl;

        اخرین مقداری که قرار میدهیم به متغغیر منتصب خواهد شد

------------------------------------------------------------------------------------------------------------------------
                                *تبدیل داده ها به یکدیگر که میتوانیم داده هارو به یکدیگر تبدیل کنیم*
                    
                          1- تبدیل انواع در عبارت های محاسباتی
                          2- تبدیل انواع در احکام انتصاب

                          در تبدیل عبارت های محاسباتی نوع کوچیک به نوع بزرگ تبدیل میشه
                          تبدیل به اینتیجر میشود  char + int  یعنی یه متغییر 
                         عبارت فلوت به دابل تغییر میکند float + double  در حاصل این عبارت 
                         حالا یک اینیجر بخواد در دابل ضرب بشه باید خودش رو به حالت دابل تبدیل کند
                         






     
  */
